{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plants-push",
	"main": "src/index.js",
	"compatibility_date": "2026-08-04",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "PLANTS_KV",
			"id": "b312490479ef404aac4a12c1b2852e39"
		}
	],
	// Daily notifications are driven by a PlantScheduler alarm, not a cron
	// trigger — the cron scheduler never dispatched to this worker (known
	// platform issue).
	"durable_objects": {
		"bindings": [
			{
				"name": "SCHEDULER",
				"class_name": "PlantScheduler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PlantScheduler"]
		}
	]
}